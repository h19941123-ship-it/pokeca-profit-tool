// Prisma スキーマ
// 参考: https://pris.ly/d/prisma-schema
//
// DB は PostgreSQL（Neon）。接続先は prisma.config.ts が
// 環境変数 DATABASE_URL から読み込む。
//
// 2026-08 に SQLite から移行した。理由は「Macを起動していなくても
// iPhoneから実データを見たい」。SQLite はファイル1個で完結する代わりに
// 置き場所がその端末に縛られるため、常時アクセスには向かない。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Card: カード情報 ＋ 仕入れ情報 ＋ 現在の販売シナリオ入力
//   MVPでは「今この価格で売ったら？」を1枚ごとに計算するため、
//   販売価格・為替・送料などの可変入力もこの行に持たせる（シンプル優先）。
//   時系列の記録は PriceHistory に保存する。
// -----------------------------------------------------------------------------
model Card {
  id Int @id @default(autoincrement())

  // --- カード基本情報 ---
  name       String // カード名（必須）
  cardNumber String? // カード番号（例: 025/165）
  setName    String? // セット名
  rarity     String? // レアリティ
  language   String  @default("JP") // 言語（JP / EN など）
  condition  String  @default("NM") // コンディション（NM / LP / PSA10 など）
  imageUrl   String? // カード画像URL

  // --- 仕入れ情報 ---
  purchasePriceJpy Int // 仕入れ価格（円）
  supplier         String? // 仕入れ先
  purchasedAt      DateTime? // 購入日
  stock            Int       @default(1) // 在庫数

  // --- 現在の販売シナリオ入力（利益計算に使用）---
  sellPriceUsd       Float  @default(0) // 想定販売価格（USD・商品本体）
  shippingChargedUsd Float  @default(0) // 購入者に請求する送料（USD）。0=送料無料
  fxRate             Float? // 為替レート（円/USD）。null なら設定の既定値を使用
  shippingJpy        Int    @default(0) // 出品者が払う国際送料（円・素体）
  gradedShippingJpy  Int    @default(0) // 鑑定スラブの国際送料（円）。0=素体送料を流用
  weightGrams        Int? // 梱包後重量（g）。送料自動計算に使用

  // --- 国内買取（海外に出すか、国内の店に売るかの比較用）---
  //   買取チェッカー等で調べた「店が買い取る値段」を入れる。
  //   仕入れ値と違い手数料が引かれないので、そのまま手取りとして比較できる。
  domesticBuybackJpy Int @default(0) // 国内買取額（円）。0=未調査

  // --- PSA鑑定シナリオ（生カードを鑑定して売る想定）---
  psa10SellUsd Float  @default(0) // PSA10 時の販売価格（USD）
  psa9SellUsd  Float  @default(0) // PSA9以下 時の販売価格（USD）
  psa10Prob    Float  @default(0) // PSA10 になる確率(%)。0なら鑑定シナリオ未設定扱い
  gradingPlan  String @default("REGULAR") // 鑑定プラン: REGULAR / EXPRESS

  // --- 予想の記録（予想と実績のズレを測る）---
  //   売れた後に販売価格を実売額へ書き換えると「売る前に何円と見込んだか」が
  //   消えてしまい、予想が当たっていたかを後から確かめられなくなる。
  //   出品中／売却済に切り替わった時点の販売価格をここへ固定する。
  //   一度入ったら上書きしない（最初の見込みこそが「予想」なので）。
  predictedSellUsd Float @default(0) // 売る前に見込んだ販売価格（USD）。0=未記録

  // --- 販売ステータス・実績 ---
  status      String    @default("STOCK") // STOCK(仕入済) / LISTED(出品中) / SOLD(売却済)
  soldPriceUsd Float    @default(0) // 実際に売れた価格（USD）
  soldAt      DateTime? // 売却日

  // --- メモ・タグ ---
  notes String? // 自由メモ
  tags  String? // タグ（カンマ区切り）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[]

  @@index([name])
  @@index([setName])
}

// -----------------------------------------------------------------------------
// Settings: 全体設定（1行のみ。id = 1 固定で運用）
//   手数料率や判定しきい値など、カード横断で使う設定値。
//   ソースに数値を埋め込まず、ここから変更できるようにする。
// -----------------------------------------------------------------------------
model Settings {
  id Int @id @default(1)

  // --- 手数料・経費（利益計算で使用）---
  ebayFeePct     Float @default(0.13) // eBay 販売手数料率（0.13 = 13%）
  ebayFixedFeeUsd Float @default(0.4) // eBay 1注文あたり定額手数料（USD）
  paymentFeePct  Float @default(0) // 決済手数料率。eBayマネージドペイメントは販売手数料に内包されるため0
  fxFeePct       Float @default(0.02) // 為替/国際手数料率
  tariffRatePct  Float @default(0) // 関税率(%)。米国DDP等。0=なし（例: 日本原産12.5）
  packingJpy     Int   @default(200) // 梱包費（円）
  otherFeeJpy    Int   @default(0) // その他手数料（円）

  // --- 為替 ---
  defaultFxRate   Float     @default(150) // 既定の為替レート（円/USD）
  autoFxUpdate    Boolean   @default(false) // 起動時に為替を自動更新するか
  lastFxUpdatedAt DateTime? // 為替を自動更新した最終日時

  // --- 仕入れ判定のしきい値（利益率 % で指定）---
  thresholdBuyPct      Float @default(30) // これ以上 → 仕入れ候補
  thresholdConsiderPct Float @default(20) // これ以上 → 検討（未満 → 見送り）
  minProfitJpy         Int   @default(0) // 最低利益額（円）。下回れば判定を下げる

  // --- 国内買取との比較 ---
  //   海外は梱包・発送・追跡・トラブル対応の手間がかかる。差額がこれ未満なら
  //   「国内で売っても大差ない」と判定して手間を避けられるようにする。
  minExportGainJpy Int @default(1000) // 海外に出す価値があると見なす最低差額（円）

  // --- まとめ発送（同梱）---
  //   カードは軽いので複数枚を1つの封筒で送っても重量帯がほとんど変わらない。
  //   1枚ずつ送る前提だと送料を数倍に見積もり、利益の出るカードを見送ってしまう。
  //   1 = 従来どおり1枚ずつ発送。
  bundleCards Int @default(1) // 1回の発送でまとめる枚数

  // --- 通知（アラート）のしきい値 ---
  notifyProfitRatePct  Float @default(30) // この利益率以上でアラート
  notifyPriceChangePct Float @default(10) // 価格がこの%以上変動したらアラート

  // --- PSA鑑定コスト（既定値。生→鑑定→販売の利益計算に使用）---
  gradingFeeRegularUsd Float @default(79.99) // PSA鑑定料 レギュラー（USD・1枚。2026-08時点の公表料金）
  gradingFeeExpressUsd Float @default(149) // PSA鑑定料 エクスプレス（USD・1枚。2026-08時点）
  gradingShipJpy       Int   @default(2000) // 鑑定の往復送料（円）
  gradingAgentJpy      Int   @default(1000) // 代行手数料（円）

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PriceHistory: 価格の時系列記録（将来の推移グラフ用）
//   MVPでは書き込みは最小限。構造だけ用意しておく。
// -----------------------------------------------------------------------------
model PriceHistory {
  id     Int  @id @default(autoincrement())
  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId Int

  recordedAt       DateTime @default(now())
  purchasePriceJpy Int
  sellPriceUsd     Float
  fxRate           Float
  profitJpy        Int
  profitRate       Float

  @@index([cardId, recordedAt])
}

// -----------------------------------------------------------------------------
// Watch: 相場ウォッチの監視対象（手動で登録する）
//   在庫として持っていないカードも狙えるよう、Card とは独立させる。
//   query は eBay に投げる検索語。日本語カード名では当たらないので英語で入れる。
// -----------------------------------------------------------------------------
model Watch {
  id Int @id @default(autoincrement())

  label         String // 画面に出す名前（日本語で可）
  query         String // eBay 検索キーワード（英語）
  marketplaceId String  @default("EBAY_US")
  active        Boolean @default(true) // 監視を一時停止できる
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  samples WatchSample[]

  @@index([active])
}

// -----------------------------------------------------------------------------
// WatchSample: 定点観測の1回分
//   出品中の価格の中央値と「出品件数」を両方残すのが要点。
//   値段が上がっても出品が増えているなら、売り手が強気になっただけかもしれない。
//   値段が上がり かつ 出品が減っているときは、実際に買われている可能性が高い。
// -----------------------------------------------------------------------------
model WatchSample {
  id      Int   @id @default(autoincrement())
  watch   Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  watchId Int

  observedAt   DateTime @default(now())
  medianUsd    Float // 相場の目安。最安・平均より外れ値に強い
  minUsd       Float
  maxUsd       Float
  listingCount Int // 出品件数

  @@index([watchId, observedAt])
}
